{
  "name": "parabol-desktop",
  "version": "2.4.1",
  "description": "Parabol media player for Windows and macOS",
  "main": "main.js",
  "author": "Parabol",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.parabol.desktop",
    "productName": "Parabol",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "media.js",
      "app/**/*",
      "build/icon.ico",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dir"
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "identity": null,
      "darkModeSupport": true
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  },
  "dependencies": {
    "ffmpeg-static": "5.2.0"
  }
}
